generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  nim       String   @unique
  nama      String
  jurusan   String
  angkatan  Int
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("students")
}
